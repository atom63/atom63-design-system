{
  "extends": "@atom63/tsconfig/react-app.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  // The ui-react library typecheck excludes its stories because they depend on
  // Storybook tooling; this app owns and typechecks them.
  "include": [
    ".storybook",
    "ssr",
    "stories",
    "vitest.config.ts",
    "../../packages/ui-react/src/**/*.stories.tsx"
  ]
}
