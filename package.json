{
  "name": "atom63-design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "pnpm": ">=10",
    "node": ">=22"
  },
  "scripts": {
    "api:report": "node scripts/design-system/api-report.mjs",
    "atom63": "node packages/cli/src/bin.mjs",
    "build:docs": "pnpm --filter @atom63/docs build",
    "build:example:product-shell": "pnpm --filter atom63-product-shell-example build",
    "build:example:vite-basic": "pnpm --filter atom63-vite-basic-example build",
    "changeset": "changeset",
    "check:agent-index": "pnpm --filter @atom63/cli check:index",
    "check:agents-md": "pnpm --filter @atom63/cli check:agents-md",
    "check:api-report": "node scripts/design-system/api-report.mjs --check",
    "check:benchmark-parity": "node scripts/design-system/audit-benchmark-parity.mjs",
    "check:control-alignment": "node scripts/design-system/check-control-alignment.mjs",
    "check:craft": "node scripts/design-system/check-craft.mjs",
    "check:dependency-version-policy": "node scripts/design-system/audit-dependency-version-policy.mjs",
    "check:ds-pack-smoke": "node scripts/design-system/smoke-packed-ui-react.mjs",
    "check:ds-registry-smoke": "node scripts/design-system/smoke-registry-ui-react.mjs",
    "check:package-correctness": "node scripts/design-system/check-package-correctness.mjs",
    "check:package-surface": "node scripts/design-system/audit-package-surface.mjs",
    "check:stable-release-preflight": "node scripts/design-system/audit-stable-release-preflight.mjs",
    "check:theme-authoring": "node scripts/design-system/check-theme-authoring.mjs",
    "check:token-economy": "node scripts/design-system/check-token-economy.mjs",
    "check:ui-react-exports": "node scripts/design-system/audit-ui-react-exports.mjs",
    "check:ui-react-monitor-evidence": "node scripts/design-system/audit-ui-react-monitor-evidence.mjs",
    "check:ui-react-size": "node scripts/design-system/check-ui-react-bundle-size.mjs",
    "check:ui-react-stable-actions": "node scripts/design-system/audit-ui-react-stable-actions.mjs",
    "check:visual-qa-matrix": "node scripts/design-system/audit-visual-qa-matrix.mjs",
    "dev:docs": "pnpm --filter @atom63/docs dev",
    "ds:new": "node scripts/design-system/ds-new.mjs",
    "format:check": "prettier --check --cache .",
    "release": "node scripts/design-system/publish-beta.mjs",
    "release:version": "changeset version && node scripts/design-system/audit-dependency-version-policy.mjs --write && node scripts/design-system/audit-stable-release-preflight.mjs --write && pnpm check:package-surface && node scripts/design-system/audit-ui-react-exports.mjs --write && node scripts/design-system/audit-ui-react-stable-actions.mjs --write",
    "test:scripts": "node --test \"scripts/design-system/lib/*.test.mjs\" \"packages/styles/scripts/lib/*.test.mjs\"",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@microsoft/api-extractor": "7.59.2",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "catalog:",
    "clsx": "^2.1.1",
    "eslint": "10.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.4.0",
    "jsdom": "catalog:",
    "lucide-react": "1.34.0",
    "playwright": "1.61.1",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "0.8.1",
    "publint": "0.3.24",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "catalog:",
    "tsup": "^8.3.5",
    "typescript": "catalog:",
    "typescript-eslint": "8.64.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "input-otp": "1.4.2",
      "lucide-react": "1.34.0",
      "react-hook-form": "7.81.0",
      "@base-ui/react": "1.6.0"
    }
  }
}
