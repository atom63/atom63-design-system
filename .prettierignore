# Prettier honours .gitignore only for files it is given via directory walking,
# not for explicit paths, so restate the important exclusions here.

node_modules/
dist/
build/
coverage/
output/
storybook-static/
**/.build/
.vite/
.next/
.claude/
pnpm-lock.yaml

# GENERATED — the generator re-emits these, so formatting them produces churn
# that comes straight back on the next run.
**/*.gen.ts
**/*.generated.ts
**/routeTree.gen.ts
# Generated by scripts/design-system/build-registry.mjs; check:registry compares it byte for byte.
apps/docs/public/r/

# CONTENT, NOT CODE — Prettier's markdown printer is not safe here. It escaped
# an MDX expression comment (`{/* … */}` → `{/\*`), which breaks the build, and
# it rewrites `*emphasis*` to `_emphasis_` across prose files.
*.md
*.mdx

# Generator output checked byte-for-byte by the check:* scripts.
packages/cli/generated/
packages/styles/generated/
packages/figma/generated/
packages/ui-react/src/styles/utilities.css
docs/design-system/audits/

# A byte-for-byte copy of atom63-site-template/src/styles/tokens; buildTemplateFiles edits it by pattern.
packages/figma/template/
