# Prettier honours .gitignore only for files it is given via directory walking,
# not for explicit paths, so restate the important exclusions here.

node_modules/
dist/
build/
coverage/
output/
storybook-static/
.turbo/
.vite/
.next/
.claude/
pnpm-lock.yaml

# GENERATED — the generator re-emits these, so formatting them produces churn
# that comes straight back on the next run.
**/*.gen.ts
**/*.generated.ts
**/routeTree.gen.ts
packages/portfolio-content/src/knowledge/knowledge-base.ts
# Generated by packages/slides/scripts/gen-theme-bundle.mjs from src/styles/themes/*.css.
# A drift-guard test regenerates and compares it, so formatting it breaks the guard.
packages/slides/src/styles/themes.css

# Scaffolding payload, not source. These files are copied verbatim into a NEW
# project; they are formatted by whatever that project configures.
packages/create-atom63/templates/
packages/create-deck/templates/
packages/create-resume/templates/

# Vendored third-party drop-ins we re-sync rather than edit. Reformatting them
# makes every upstream re-sync a conflict.
apps/atom63.io/src/components/magicui/
apps/atom63.io/src/components/vendor/
apps/atom63.io/src/components/animation/
apps/atom63.io/src/components/animate-ui/

# CONTENT, NOT CODE — Prettier's markdown printer is not safe here. It escaped
# an MDX expression comment (`{/* … */}` → `{/\*`), which breaks the build, and
# it rewrites `*emphasis*` to `_emphasis_` across every portfolio prose file.
# Biome never formatted these either, so nothing is lost by excluding them.
*.md
*.mdx

# Frozen, superseded code (see archive/README.md) — never formatted.
archive/

# Imported Windows Shell boilerplate — owns its own Biome/ultracite formatting
# and upstream sync. Root Prettier must not reformat it (nightly guardrails).
apps/windows-shell/

# Generator output checked byte-for-byte by the check:* scripts.
packages/styles/generated/
packages/ui-react/src/styles/utilities.css
docs/design-system/audits/
