# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/output

# build output
dist/
/.build/

# turbo
.turbo/

# misc
.DS_Store
*.pem

# agent scratch space — nothing written here belongs in the repo, and an
# untracked dir here makes `git status` unreliable as a "clean tree?" check
tmp/

# Claude Code (local overrides)
.claude/settings.local.json
.claude/launch.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/
debug-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# Superpowers brainstorming session files
.superpowers/

# Git worktrees
.worktrees/

# Storybook build output (root `pnpm storybook` build)
storybook-static/

# Local agent / tooling caches
.playwright-cli/
.clone/

# Turborepo
.turbo

# ESLint
.eslintcache
.audit/

# Storybook visual regression: only CI's Linux baselines are committed.
apps/storybook/visual/__diff__/
apps/storybook/.vitest-attachments/
apps/storybook/visual/__screenshots__/*-darwin.png
apps/storybook/visual/__screenshots__/*-win32.png
apps/storybook/storybook-static/
