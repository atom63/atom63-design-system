# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/output

# build output
dist/
/.build/

# turbo
.turbo/

# Workspace-package-specific patterns live in each package's .gitignore
# (e.g. websites/atom63.io/.gitignore covers dist/, .tanstack/tmp/, .next/, etc.)

# misc
.DS_Store
*.pem

# agent scratch space — nothing written here belongs in the repo, and an
# untracked dir here makes `git status` unreliable as a "clean tree?" check
tmp/

# Claude Code (local overrides)
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/
debug-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Creative local workspaces
# Commit workflow docs/templates/scripts. Keep specific content assets,
# research briefs, production folders, generated media, and experiments local
# unless intentionally promoted into a public app or shared asset package.
creative/backlog.md
creative/.local-assets.json
creative/experiments/
creative/productions/
creative/art-direction/*.md
!creative/art-direction/README.md
creative/concepts/*.md
!creative/concepts/README.md
creative/research/*.md
!creative/research/README.md

# Local one-off creative experiment scripts. New reusable workflow scripts live
# under scripts/creative/ and should be reviewed explicitly.
scripts/audition-chinese-tts.mjs
scripts/bake-storyboard-text.mjs
scripts/generate-design-system-tts.mjs
scripts/render-caption-occlusion-check.mjs
scripts/render-caption-visual-options.mjs
scripts/render-design-system-rough-cut.mjs
scripts/render-design-system-v2-assembly.mjs
scripts/render-sticker-stop-motion-assembly.mjs
scripts/render-storyboard-contact-sheet.mjs
scripts/render-styleframe-contact-sheet.mjs
scripts/render-video-contact-sheet.mjs
scripts/render-vintage-educational-assembly.mjs
scripts/run-i2v-tests.mjs
scripts/run-sticker-stop-motion-i2v.mjs
scripts/run-sticker-stop-motion-storyboard-i2v.mjs
scripts/run-vintage-storyboard-i2v.mjs

# vercel
.vercel

# typescript
*.tsbuildinfo

# Superpowers brainstorming session files
.superpowers/

# Git worktrees
.worktrees/

# Storybook build output (root `pnpm storybook` build)
storybook-static/

# Local agent / tooling caches
.playwright-cli/
.clone/

# Turborepo
.turbo

# ESLint
.eslintcache
.audit/

# Generated by `create-atom63`'s build: tsup copies apps/scaffold-preview here
# so the packed CLI carries a template. Tracking the copy let it drift from its
# source — a full build would silently dirty the tree with the diff.
packages/create-atom63/templates/

# Storybook visual regression: only CI's Linux baselines are committed.
apps/storybook/visual/__diff__/
apps/storybook/.vitest-attachments/
apps/storybook/visual/__screenshots__/*-darwin.png
apps/storybook/visual/__screenshots__/*-win32.png
apps/storybook/storybook-static/
