{
  "name": "@atom63/styles",
  "version": "0.0.1",
  "description": "CSS tokens, themes, contracts, and utilities for the Atom63 design system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATOM63/atom63-vite.git",
    "directory": "packages/styles"
  },
  "homepage": "https://github.com/ATOM63/atom63-vite/tree/main/packages/styles#readme",
  "bugs": {
    "url": "https://github.com/ATOM63/atom63-vite/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "atom63",
    "design-system",
    "css",
    "design-tokens",
    "themes",
    "tailwindcss"
  ],
  "type": "module",
  "style": "./src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./compat": "./src/compat/index.css",
    "./compat/a63-from-shadcn": "./src/compat/a63-from-shadcn.css",
    "./animations": "./src/animations/index.css",
    "./compat/mdx": "./src/compat/mdx.css",
    "./compat/shadcn": "./src/compat/shadcn.css",
    "./contracts": "./src/contracts/index.css",
    "./contracts/action": "./src/contracts/action.css",
    "./contracts/choice": "./src/contracts/choice.css",
    "./contracts/control": "./src/contracts/control.css",
    "./contracts/environment": "./src/contracts/environment.css",
    "./contracts/field": "./src/contracts/field.css",
    "./contracts/marker": "./src/contracts/marker.css",
    "./contracts/menu": "./src/contracts/menu.css",
    "./contracts/overlay": "./src/contracts/overlay.css",
    "./contracts/segment": "./src/contracts/segment.css",
    "./contracts/selection": "./src/contracts/selection.css",
    "./contracts/surface": "./src/contracts/surface.css",
    "./contracts/toggle": "./src/contracts/toggle.css",
    "./contracts/track": "./src/contracts/track.css",
    "./contracts/trigger": "./src/contracts/trigger.css",
    "./contracts/widget": "./src/contracts/widget.css",
    "./tailwind": "./src/tailwind/index.css",
    "./tailwind/animations": "./src/tailwind/animations.css",
    "./tailwind/theme": "./src/tailwind/theme.css",
    "./tailwind/utilities": "./src/tailwind/utilities.css",
    "./tailwind/variants": "./src/tailwind/variants.css",
    "./themes": "./src/themes/index.css",
    "./themes/aqua": "./src/themes/aqua.css",
    "./themes/modern": "./src/themes/modern.css",
    "./themes/retro": "./src/themes/retro.css",
    "./themes/terminal": "./src/themes/terminal.css",
    "./os": "./src/os/index.css",
    "./os/macos": "./src/os/macos.css",
    "./os/windows": "./src/os/windows.css",
    "./tokens": "./src/tokens/index.css",
    "./tokens/brand": "./src/tokens/brand.css",
    "./tokens/foundation": "./src/tokens/foundation.css",
    "./tokens/foundation/aliases": "./src/tokens/foundation/aliases.css",
    "./tokens/foundation/effects": "./src/tokens/foundation/effects.css",
    "./tokens/foundation/fonts": "./src/tokens/foundation/fonts.css",
    "./tokens/foundation/motion": "./src/tokens/foundation/motion.css",
    "./tokens/foundation/palette": "./src/tokens/foundation/palette.css",
    "./tokens/foundation/primitives": "./src/tokens/foundation/primitives.css",
    "./tokens/foundation/radius": "./src/tokens/foundation/radius.css",
    "./tokens/foundation/typography": "./src/tokens/foundation/typography.css",
    "./tokens/motion": "./src/tokens/motion.css",
    "./tokens/radius": "./src/tokens/radius.css",
    "./tokens/semantics": "./src/tokens/semantics.css",
    "./tokens/space": "./src/tokens/space.css",
    "./tokens/surface": "./src/tokens/surface.css",
    "./utils": "./src/utils/index.css",
    "./utils/code-highlighting": "./src/utils/code-highlighting.css",
    "./utils/debug": "./src/utils/debug.css",
    "./utils/scroll-bar": "./src/utils/scroll-bar.css",
    "./utils/scroll-mask": "./src/utils/scroll-mask.css",
    "./utils/view-transition": "./src/utils/view-transition.css",
    "./z-layers": {
      "typescript": "./src/z-layers.ts",
      "types": "./src/z-layers.ts",
      "default": "./src/z-layers.ts"
    }
  },
  "files": [
    "generated",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "generate:tokens": "node scripts/generate-token-manifest.mjs",
    "check:tokens": "node scripts/check-token-manifest.mjs",
    "lint": "eslint . --cache --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@atom63/eslint-config": "workspace:*",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "10.7.0",
    "playwright": "1.61.1",
    "vitest": "catalog:"
  }
}
