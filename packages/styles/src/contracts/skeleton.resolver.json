{
  "version": "2025.10",
  "description": "Skeleton appearance contract.\n\nRenderers may use different masking primitives, but the base surface and\nhighlight emphasis remain shared design semantics. Each mode block repeats\nthe base alias so a nested light or dark scope resolves it against its own\nsurface roles.",
  "modifiers": {
    "mode": {
      "default": "light",
      "contexts": {
        "light": [
          {
            "a63": {
              "skeleton": {
                "base": {
                  "$type": "color",
                  "$value": "{a63.surface.muted}"
                },
                "highlight": {
                  "$type": "color",
                  "$value": "{color.white.60}"
                }
              }
            }
          }
        ],
        "dark": [
          {
            "a63": {
              "skeleton": {
                "base": {
                  "$type": "color",
                  "$value": "{a63.surface.muted}"
                },
                "highlight": {
                  "$type": "color",
                  "$value": "{color.white.10}"
                }
              }
            }
          }
        ]
      }
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/modifiers/mode"
    }
  ],
  "$extensions": {
    "io.atom63.css": {
      "attribute": "data-a63-mode",
      "selectors": {
        "light": ":root,\n.light,\n[data-a63-mode='light']",
        "dark": ":is(.dark, [data-a63-mode='dark'])"
      },
      "rescope": {
        "selector": "[data-a63-brand], [data-a63-surface]",
        "light": "light",
        "dark": "dark"
      }
    }
  }
}
