    "09-is-data-a63-design-language-ios-data-design-lang": {
      "sources": [
        {
          "a63": {
            "control": {
              "height": {
                "xs": {
                  "$type": "dimension",
                  "$value": "{a63.space.unit}",
                  "$extensions": {
                    "io.atom63.derive": "calc({a63.space.unit} * 9)"
                  }
                },
                "sm": {
                  "$type": "dimension",
                  "$value": "{a63.space.unit}",
                  "$extensions": {
                    "io.atom63.derive": "calc({a63.space.unit} * 10)"
                  }
                },
                "md": {
                  "$type": "dimension",
                  "$value": "{a63.space.unit}",
                  "$extensions": {
                    "io.atom63.derive": "calc({a63.space.unit} * 11)"
                  }
                },
                "lg": {
                  "$type": "dimension",
                  "$value": "{a63.space.unit}",
                  "$extensions": {
                    "io.atom63.derive": "calc({a63.space.unit} * 12)"
                  }
                },
                "xl": {
                  "$type": "dimension",
                  "$value": "{a63.space.unit}",
                  "$extensions": {
                    "io.atom63.derive": "calc({a63.space.unit} * 13)"
                  }
                }
              },
              "padding": {
                "inline": {
                  "xs": {
                    "$type": "dimension",
                    "$value": "{a63.space.3}"
                  },
                  "sm": {
                    "$type": "dimension",
                    "$value": "{a63.space.3_5}"
                  },
                  "md": {
                    "$type": "dimension",
                    "$value": "{a63.space.4}"
                  },
                  "lg": {
                    "$type": "dimension",
                    "$value": "{a63.space.5}"
                  },
                  "xl": {
                    "$type": "dimension",
                    "$value": "{a63.space.6}"
                  }
                }
              },
              "font": {
                "weight": {
                  "$type": "number",
                  "$value": 600
                },
                "size": {
                  "xs": {
                    "$type": "dimension",
                    "$value": "{typography.xs.font.size}"
                  },
                  "sm": {
                    "$type": "dimension",
                    "$value": "{typography.sm.font.size}"
                  },
                  "md": {
                    "$type": "dimension",
                    "$value": "{typography.base.font.size}"
                  },
                  "lg": {
                    "$type": "dimension",
                    "$value": "{typography.lg.font.size}"
                  },
                  "xl": {
                    "$type": "dimension",
                    "$value": "{typography.lg.font.size}"
                  }
                }
              },
              "icon": {
                "size": {
                  "xs": {
                    "$type": "dimension",
                    "$value": {
                      "value": 0.875,
                      "unit": "rem"
                    }
                  },
                  "sm": {
                    "$type": "dimension",
                    "$value": {
                      "value": 1,
                      "unit": "rem"
                    }
                  },
                  "md": {
                    "$type": "dimension",
                    "$value": {
                      "value": 1.125,
                      "unit": "rem"
                    }
                  },
                  "lg": {
                    "$type": "dimension",
                    "$value": {
                      "value": 1.25,
                      "unit": "rem"
                    }
                  },
                  "xl": {
                    "$type": "dimension",
                    "$value": {
                      "value": 1.375,
                      "unit": "rem"
                    }
                  }
                }
              },
              "feedback": {
                "ease": {
                  "$type": "duration",
                  "$value": "{a63.motion.ease.emphasized}"
                }
              }
            },
            "row": {
              "padding": {
                "block": {
                  "xs": {
                    "$type": "dimension",
                    "$value": "{a63.space.1}",
                    "$description": "Rows stop padding their way to height and let the control ramp floor them,\n   so a single-line row lands on 44pt and a two-line row on ~59pt, instead of\n   52pt and 75pt. Targets are from our measurement study, not a published\n   Apple row height — there isn't one."
                  },
                  "sm": {
                    "$type": "dimension",
                    "$value": "{a63.space.1_5}"
                  },
                  "md": {
                    "$type": "dimension",
                    "$value": "{a63.space.2}"
                  }
                }
              }
            },
            "switch": {
              "thumb": {
                "size": {
                  "$type": "dimension",
                  "$value": {
                    "value": 1.375,
                    "unit": "rem"
                  },
                  "$description": "Larger, iconic iOS pill switch (web default is 1rem in selection.css)."
                }
              }
            }
          }
        }
      ],
      "$extensions": {
        "io.atom63.css": {
          "selector": ":is([data-a63-design-language='ios'], [data-design-language='ios'])"
        }
      }
    }
  },
