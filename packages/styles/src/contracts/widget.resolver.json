{
  "version": "2025.10",
  "description": "Widget contract — a persistent floating surface hosted on a desktop, card\nflow, or agent surface. Defaults compose the overlay archetype; widget kinds\ncan specialize the material without replacing surface anatomy.\n\nRaised media sitting ON a widget face — poster-fan prints, stacked cards.\n\nDeliberately heavier than --a63-widget-shadow: the tile floats above the\ndesktop, but this is print stock resting on the tile, so it needs a near\ncontact throw plus a far soft one to read as a physical object rather than a\nsecond pane. `-raised` is the focused/centered print; the base token is the\nresting one.\n\nEach stack carries its own hairline rim and specular inset, so the consumer\npaints ONE box-shadow. A separate `ring` utility is composed into box-shadow\nas well, so it would clobber the whole stack rather than sit beside it.\n\nMode-split like semantics.css: the throw is far stronger on a dark face, and\nthe hairline rim flips from a white specular edge to a dark hairline.\n\nWeather FACE material — shared by the weather tile and by Location when it\ncarries a condition tone. Outer chrome (rim + drop shadow) stays on the\nshared widget defaults so every tile reads as one system; only the face\nfill / foreground specialize.\n\nSticky note focus: lift the shared rim shadow while editing. The variable\n lives on the shell (where box-shadow is painted), so it must be set there —\n a face-only className cannot reach it.",
  "sets": {
    "01-root": {
      "sources": [
        {
          "a63": {
            "widget": {
              "background": {
                "color": {
                  "$type": "color",
                  "$value": "{a63.surface.overlay}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix(in oklab, {a63.surface.overlay} 82%, transparent)"
                  }
                },
                "image": {
                  "$type": "color",
                  "$value": "{a63.overlay.gloss}",
                  "$extensions": {
                    "io.atom63.derive": "{a63.overlay.gloss}, {a63.overlay.texture.image}"
                  }
                },
                "blend": {
                  "$type": "color",
                  "$value": "{a63.overlay.texture.blend}",
                  "$extensions": {
                    "io.atom63.derive": "normal, {a63.overlay.texture.blend}"
                  }
                }
              },
              "foreground": {
                "$type": "color",
                "$value": "{a63.text.primary}"
              },
              "border": {
                "color": {
                  "$type": "color",
                  "$value": "{a63.border.subtle}"
                },
                "style": {
                  "$type": "strokeStyle",
                  "$value": "{a63.overlay.border.style}"
                },
                "width": {
                  "$type": "dimension",
                  "$value": {
                    "value": 0,
                    "unit": "px"
                  },
                  "$description": "No border by default: the rim IS the tile's edge. A hairline on the face\n   inside a 4px rim reads as a second concentric ring."
                }
              },
              "radius": {
                "$type": "dimension",
                "$value": "{radius.xl}",
                "$extensions": {
                  "io.atom63.derive": "var(--a63-overlay-radius, {radius.xl})"
                }
              },
              "shadow": {
                "$type": "shadow",
                "$value": [],
                "$description": "Flat by default: the 4px rim already separates the tile from the page, so a\n   drop shadow on top of it reads as a second edge rather than as height. The\n   shadow stays available as a STATE — sticky-note focus and drag both raise\n   it — and each skin still opts into its own resting elevation (retro's hard\n   offset, terminal's phosphor glow, aqua's gel drop) on its theme scope.\n   `none` is safe as the sole value here; it would only be invalid if composed\n   into a comma-separated list."
              },
              "rim": {
                "width": {
                  "$type": "dimension",
                  "$value": {
                    "value": 4,
                    "unit": "px"
                  },
                  "$description": "Rim = the padded outer shell between the tile edge and the card face. A\n   padded rim can carry a gradient across the whole frame; a box-shadow inset\n   cannot. Themes fill it via --a63-widget-rim-image."
                },
                "color": {
                  "$type": "color",
                  "$value": "{a63.border.subtle}"
                },
                "border": {
                  "color": {
                    "$type": "color",
                    "$value": {
                      "colorSpace": "srgb",
                      "components": [0, 0, 0],
                      "alpha": 0
                    },
                    "$extensions": {
                      "io.atom63.derive": "transparent"
                    },
                    "$description": "Per-side rim color. The rim is a border, so this mitres around the corner\n   arc at ANY radius — which is how a bevel theme lights top+left and darkens\n   bottom+right without breaking when the radius axis is turned up. Transparent\n   by default so gradient rims show through from --a63-widget-rim-image."
                  }
                }
              }
            },
            "weather": {
              "background": {
                "color": {
                  "$type": "color",
                  "$value": {
                    "colorSpace": "srgb",
                    "components": [0, 0, 0],
                    "alpha": 0
                  },
                  "$extensions": {
                    "io.atom63.derive": "transparent"
                  },
                  "$description": "Weather defaults preserve live condition color in the neutral theme."
                }
              },
              "foreground": {
                "$type": "color",
                "$value": "{color.white.100}",
                "$extensions": {
                  "io.atom63.derive": "white"
                }
              },
              "muted": {
                "foreground": {
                  "$type": "color",
                  "$value": {
                    "colorSpace": "srgb",
                    "components": [1.0, 1.0, 1.0],
                    "alpha": 0.7
                  },
                  "$extensions": {
                    "io.atom63.derive": "rgb(255 255 255 / 0.7)"
                  }
                }
              },
              "divider": {
                "color": {
                  "$type": "color",
                  "$value": {
                    "colorSpace": "srgb",
                    "components": [1.0, 1.0, 1.0],
                    "alpha": 0.2
                  },
                  "$extensions": {
                    "io.atom63.derive": "rgb(255 255 255 / 0.2)"
                  }
                }
              },
              "text": {
                "shadow": {
                  "$type": "shadow",
                  "$value": []
                }
              },
              "border": {
                "color": {
                  "$type": "color",
                  "$value": {
                    "colorSpace": "srgb",
                    "components": [0, 0, 0],
                    "alpha": 0
                  },
                  "$extensions": {
                    "io.atom63.derive": "transparent"
                  }
                }
              },
              "condition": {
                "mode": {
                  "color": {
                    "$type": "color",
                    "$value": {
                      "colorSpace": "srgb",
                      "components": [0, 0, 0],
                      "alpha": 0
                    },
                    "$extensions": {
                      "io.atom63.derive": "transparent"
                    }
                  }
                },
                "color": {
                  "strength": {
                    "$type": "number",
                    "$value": 100,
                    "$extensions": {
                      "io.atom63.derive": "100%"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "$extensions": {
        "io.atom63.css": {
          "selector": ":root"
        }
      }
    },
