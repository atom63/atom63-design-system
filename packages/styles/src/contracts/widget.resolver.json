    "04-data-widget-kind-weather-data-widget-kind-locati": {
      "sources": [
        {
          "a63": {
            "widget": {
              "background": {
                "color": {
                  "$type": "color",
                  "$value": "{a63.weather.background.color}"
                },
                "image": {
                  "$type": "color",
                  "$value": "{a63.weather.condition.background.image}",
                  "$extensions": {
                    "io.atom63.derive": "var( --a63-weather-background-image, {a63.weather.condition.background.image} )"
                  }
                },
                "blend": {
                  "$type": "color",
                  "$value": "{a63.weather.background.blend}"
                }
              },
              "foreground": {
                "$type": "color",
                "$value": "{a63.weather.foreground}"
              }
            },
            "weather": {
              "condition": {
                "background": {
                  "image": {
                    "$type": "color",
                    "$value": "{a63.weather.condition.start}",
                    "$extensions": {
                      "io.atom63.derive": "linear-gradient( 135deg, color-mix( in oklch, {a63.weather.condition.start} {a63.weather.condition.color.strength}, {a63.weather.condition.mode.color} ), color-mix( in oklch, {a63.weather.condition.end} {a63.weather.condition.color.strength}, {a63.weather.condition.mode.color} ) )"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "$extensions": {
        "io.atom63.css": {
          "selector": "[data-widget-kind='weather'], [data-widget-kind='location'][data-weather-tone]"
        }
      }
    },
