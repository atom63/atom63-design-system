                    "value": 2,
                    "unit": "px"
                  }
                }
              },
              "focus": {
                "ring": {
                  "width": {
                    "$type": "dimension",
                    "$value": {
                      "value": 2,
                      "unit": "px"
                    }
                  }
                }
              },
              "shadow": {
                "$root": {
                  "$type": "shadow",
                  "$value": "{retro.bevel.drop}",
                  "$extensions": {
                    "io.atom63.derive": "inset 2px 2px 0 color-mix(in oklch, white 55%, transparent), inset -2px -2px 0 color-mix(in oklch, black 28%, transparent), {retro.bevel.drop}"
                  }
                },
                "active": {
                  "$type": "shadow",
                  "$value": [
                    {
                      "color": {
                        "colorSpace": "srgb",
                        "components": [0, 0, 0],
                        "alpha": 0.3
                      },
                      "offsetX": {
                        "value": 2,
                        "unit": "px"
                      },
                      "offsetY": {
                        "value": 2,
                        "unit": "px"
                      },
                      "blur": {
                        "value": 0,
                        "unit": "px"
                      },
                      "spread": {
                        "value": 0,
                        "unit": "px"
                      },
                      "inset": true
                    },
                    {
                      "color": {
                        "colorSpace": "srgb",
                        "components": [1, 1, 1],
                        "alpha": 0.22
                      },
                      "offsetX": {
                        "value": -1,
                        "unit": "px"
                      },
                      "offsetY": {
                        "value": -1,
                        "unit": "px"
                      },
                      "blur": {
                        "value": 0,
                        "unit": "px"
                      },
                      "spread": {
                        "value": 0,
                        "unit": "px"
                      },
                      "inset": true
                    }
                  ],
                  "$extensions": {
                    "io.atom63.derive": "inset 2px 2px 0 color-mix(in oklch, black 30%, transparent), inset -1px -1px 0 color-mix(in oklch, white 22%, transparent)"
                  },
                  "$description": "Pressed: the bevel inverts (recessed) and the hard drop collapses — the\n   button physically pushes in. Pairs with the default translateY(1px) press."
                }
              }
            },
            "field": {
              "shadow": {
                "$type": "shadow",
                "$value": [
                  {
                    "color": {
                      "colorSpace": "srgb",
                      "components": [0, 0, 0],
                      "alpha": 0.22
                    },
                    "offsetX": {
                      "value": 2,
                      "unit": "px"
                    },
                    "offsetY": {
                      "value": 2,
                      "unit": "px"
                    },
                    "blur": {
                      "value": 0,
                      "unit": "px"
                    },
                    "spread": {
                      "value": 0,
                      "unit": "px"
                    },
                    "inset": true
                  },
                  {
                    "color": {
                      "colorSpace": "srgb",
                      "components": [1, 1, 1],
                      "alpha": 0.4
                    },
                    "offsetX": {
                      "value": -1,
                      "unit": "px"
