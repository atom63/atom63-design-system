                }
              },
              "border": {
                "style": {
                  "$type": "strokeStyle",
                  "$value": "outset"
                },
                "width": {
                  "$type": "dimension",
                  "$value": {
                    "value": 2,
                    "unit": "px"
                  }
                }
              },
              "drag": {
                "shadow": {
                  "$type": "shadow",
                  "$value": "{retro.bevel.drop.lg}",
                  "$extensions": {
                    "io.atom63.derive": "inset 1px 1px 0 color-mix(in oklch, white 50%, transparent), inset -1px -1px 0 color-mix(in oklch, black 22%, transparent), {retro.bevel.drop.lg}"
                  }
                }
              }
            },
            "widget": {
              "rim": {
                "width": {
                  "$type": "dimension",
                  "$value": {
                    "value": 2,
                    "unit": "px"
                  },
                  "$description": "Win98 bevel as real geometry: light on top + left, dark on bottom + right.\n   Per-side BORDER colors, so the bevel mitres around the corner arc and holds\n   at any radius — radius is a personalization axis, not a per-theme constant.\n   Order: top right bottom left."
                },
                "border": {
                  "color": {
                    "$type": "color",
                    "$value": "{color.white.100}",
                    "$extensions": {
                      "io.atom63.derive": "color-mix(in oklch, white 50%, transparent) color-mix(in oklch, black 22%, transparent) color-mix(in oklch, black 22%, transparent) color-mix(in oklch, white 50%, transparent)"
                    }
                  }
                }
              },
              "shadow": {
                "$type": "shadow",
                "$value": "{retro.bevel.drop.md}",
                "$description": "Bevel moved to the rim; keep only the hard drop."
              },
              "background": {
                "color": {
                  "$type": "color",
                  "$value": "{a63.surface.overlay}",
                  "$description": "Opaque face. The contract's 82% default lets the rim gradient bleed through,\n   which turns the bevel's hard diagonal stop into a seam across the whole card.\n   Win98 plastic is not glass — the face should be solid regardless."
                }
              }
            },
            "surface": {
              "shadow": {
                "$type": "shadow",
                "$value": "{retro.bevel.drop.soft}",
                "$extensions": {
                  "io.atom63.derive": "inset 1px 1px 0 color-mix(in oklch, white 55%, transparent), inset -1px -1px 0 color-mix(in oklch, black 22%, transparent), {retro.bevel.drop.soft}"
                }
              },
              "border": {
                "style": {
                  "$type": "strokeStyle",
                  "$value": "outset",
                  "$description": "Retro surfaces/overlays are chunky beveled frames: 2px outset border, hard\n   square corners via the radius personalization axis (not hardcoded here)."
                },
                "width": {
                  "$type": "dimension",
                  "$value": {
                    "value": 2,
                    "unit": "px"
                  }
                }
              }
            },
