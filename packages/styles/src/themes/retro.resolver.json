{
  "version": "2025.10",
  "description": "Retro theme — early-web / Windows-98 chrome: thick beveled edges and hard\noffset shadows.\n\nValue-overrides only. Bevel stacks are theme-private under this selector.\nBoxier radius and chunky borders complete the physical look.",
  "sets": {
    "01-data-a63-theme-retro": {
      "sources": [
        {
          "retro": {
            "bevel": {
              "drop": {
                "$root": {
                  "$type": "shadow",
                  "$value": [
                    {
                      "color": {
                        "colorSpace": "srgb",
                        "components": [0, 0, 0],
                        "alpha": 0.3
                      },
                      "offsetX": {
                        "value": 2,
                        "unit": "px"
                      },
                      "offsetY": {
                        "value": 2,
                        "unit": "px"
                      },
                      "blur": {
                        "value": 0,
                        "unit": "px"
                      },
                      "spread": {
                        "value": 0,
                        "unit": "px"
                      }
                    }
                  ],
                  "$extensions": {
                    "io.atom63.derive": "2px 2px 0 color-mix(in oklch, black 30%, transparent)"
                  },
                  "$description": "Theme-private helpers reused across contract knobs."
                },
                "md": {
                  "$type": "shadow",
                  "$value": [
                    {
                      "color": {
                        "colorSpace": "srgb",
                        "components": [0, 0, 0],
                        "alpha": 0.3
                      },
                      "offsetX": {
                        "value": 3,
                        "unit": "px"
                      },
                      "offsetY": {
                        "value": 3,
                        "unit": "px"
                      },
                      "blur": {
                        "value": 0,
                        "unit": "px"
                      },
                      "spread": {
                        "value": 0,
                        "unit": "px"
                      }
                    }
                  ],
                  "$extensions": {
                    "io.atom63.derive": "3px 3px 0 color-mix(in oklch, black 30%, transparent)"
                  }
                },
                "lg": {
                  "$type": "shadow",
                  "$value": [
                    {
                      "color": {
                        "colorSpace": "srgb",
                        "components": [0, 0, 0],
                        "alpha": 0.34
                      },
                      "offsetX": {
                        "value": 4,
                        "unit": "px"
                      },
                      "offsetY": {
                        "value": 4,
                        "unit": "px"
                      },
                      "blur": {
                        "value": 0,
                        "unit": "px"
                      },
                      "spread": {
                        "value": 0,
                        "unit": "px"
                      }
                    }
                  ],
                  "$extensions": {
                    "io.atom63.derive": "4px 4px 0 color-mix(in oklch, black 34%, transparent)"
                  }
                },
                "soft": {
                  "$type": "shadow",
                  "$value": [
                    {
                      "color": {
                        "colorSpace": "srgb",
                        "components": [0, 0, 0],
                        "alpha": 0.16
                      },
                      "offsetX": {
                        "value": 2,
                        "unit": "px"
                      },
                      "offsetY": {
                        "value": 2,
                        "unit": "px"
                      },
                      "blur": {
                        "value": 0,
                        "unit": "px"
                      },
                      "spread": {
                        "value": 0,
                        "unit": "px"
                      }
                    }
                  ],
                  "$extensions": {
                    "io.atom63.derive": "2px 2px 0 color-mix(in oklch, black 16%, transparent)"
                  }
                }
              }
            }
          },
          "a63": {
            "control": {
              "radius": {
                "$type": "dimension",
