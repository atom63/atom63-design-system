    "02-data-a63-theme-aqua-is-root-light-data-a63-mode-": {
      "sources": [
        {
          "a63": {
            "surface": {
              "page": {
                "$type": "color",
                "$value": "{surface.light.2}",
                "$extensions": {
                  "io.atom63.derive": "color-mix(in oklab, {surface.light.2} 95%, {color.b1.500})"
                }
              },
              "panel": {
