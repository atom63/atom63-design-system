{
  "$description": "Text roles, named after the Apple HIG text styles so one intent maps to every platform. Each\nrole takes a step of the web type scale (and so follows the window size and type scale) and\nrecords its iOS text style in $extensions[\"io.atom63.platforms\"]; on iOS the role uses that\nFont.TextStyle and Dynamic Type. -strong is the emphasized weight: bold for the three largest\ntitles, semibold for the rest. Web sizes follow web conventions (body is 15px here, 17pt on\niOS); the role, not the number, is what stays the same.",
  "a63": {
    "type": {
      "large-title": {
        "font-size": {
          "$type": "dimension",
          "$value": "{typography.6xl.font.size}",
          "$extensions": {
            "io.atom63.platforms": {
              "ios": {
                "textStyle": "largeTitle",
                "dynamicType": "system"
              }
            }
          }
        },
        "line-height": {
          "$type": "dimension",
          "$value": "{typography.6xl.line.height}"
        },
        "font-weight": {
          "$type": "fontWeight",
          "$value": 400
        },
        "font-weight-strong": {
          "$type": "fontWeight",
          "$value": 700
        }
      },
      "title-1": {
        "font-size": {
          "$type": "dimension",
          "$value": "{typography.5xl.font.size}",
          "$extensions": {
            "io.atom63.platforms": {
              "ios": {
                "textStyle": "title",
                "dynamicType": "system"
              }
            }
          }
        },
        "line-height": {
          "$type": "dimension",
          "$value": "{typography.5xl.line.height}"
        },
        "font-weight": {
          "$type": "fontWeight",
          "$value": 400
        },
        "font-weight-strong": {
          "$type": "fontWeight",
          "$value": 700
        }
      },
