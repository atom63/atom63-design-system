{
  "version": "2025.10",
  "description": "Canonical semantic layer.\n\nThis is the single source of semantic truth for the new system. Values are\nsourced directly from the token foundation (surface aliases + primitives),\nwith .dark overrides where the mode differs. shadcn (--background/--primary…)\nand Tailwind are opt-in adapters that re-reference THESE names — never the\nreverse. See packages/styles/README.md (the mirror rule).",
  "sets": {
    "base": {
      "sources": [
        {
          "a63": {
            "surface": {
              "tint": {
                "$type": "number",
                "$value": 0,
                "$extensions": {
                  "io.atom63.derive": "0%"
                }
              }
            },
            "scrim": {
              "$type": "color",
              "$value": "{color.black.100}",
              "$extensions": {
                "io.atom63.derive": "color-mix(in oklch, black 40%, transparent)"
              },
              "$description": "Scrim — the modal/drawer/sheet backdrop veil behind overlays."
            },
            "media": {
              "stage": {
                "$type": "color",
                "$value": "{color.black.100}",
                "$description": "Media stage — behind full-screen photos and video: black in every theme, so letterboxing matches the picture."
              },
              "scrim": {
                "$type": "color",
                "$value": "{color.black.70}",
                "$description": "Media scrim — the dim behind a video dialog; heavier than --a63-scrim because the video is the only thing on screen."
              }
            },
            "on-media": {
              "foreground": {
                "$type": "color",
                "$value": "{color.white.100}",
                "$description": "On media — icons and text on controls that float over photos and video, whose colors are unknowable."
              },
              "surface": {
                "$type": "color",
                "$value": "{color.black.60}",
                "$description": "On media — the backplate of a floating control, dark enough that its foreground reads over any picture."
              },
              "surface-strong": {
                "$type": "color",
                "$value": "{color.black.70}",
                "$description": "On media — the backplate at rest for a primary control (play) and on hover for the others."
              },
              "border": {
                "$type": "color",
                "$value": "{color.white.20}",
                "$description": "On media — the hairline that separates a floating control from a dark picture."
              },
              "ring": {
                "$type": "color",
                "$value": "{color.white.90}",
                "$description": "On media — the focus ring for controls over media."
              },
              "veil": {
                "$type": "color",
                "$value": "{color.black.10}",
                "$description": "On media — a light veil over a poster while it waits."
              },
              "veil-strong": {
                "$type": "color",
                "$value": "{color.black.20}",
                "$description": "On media — the veil over a poster while a control on it is shown."
              }
            },
            "selected": {
              "background": {
                "$type": "color",
                "$value": "{a63.action.primary}",
                "$description": "A selected item in a list, menu or grid: a light wash of the primary.",
                "$extensions": {
                  "io.atom63.derive": "color-mix(in oklch, {a63.action.primary} 12%, transparent)"
                }
              },
              "foreground": {
                "$type": "color",
                "$value": "{a63.text.accent}",
                "$description": "Text and icons of a selected item."
              }
            },
            "chart": {
              "1": {
                "$type": "color",
                "$value": "{a63.action.primary}",
                "$description": "Chart series colors. Series 1 is the primary; 2–5 are fixed hues that stay\ndistinct from it and from each other (500 on light surfaces, 400 on dark)."
              }
            }
          }
        }
      ],
      "$extensions": {
        "io.atom63.css": {
          "selector": ":root"
        }
      }
    }
  },
  "modifiers": {
    "mode": {
      "default": "light",
      "contexts": {
        "light": [
          {
            "a63": {
              "surface": {
                "page": {
                  "$type": "color",
                  "$value": "{surface.light.2}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.light.2} calc(100% - {a63.surface.tint}), {a63.brand.100} {a63.surface.tint} )"
                  },
                  "$description": "Surfaces — neutral, optionally bent toward the brand hue by --a63-surface-tint\n(0% = pure neutral). Each mixes with a lightness-matched --a63-brand-* step."
                },
                "panel": {
                  "$type": "color",
                  "$value": "{surface.light.1}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.light.1} calc(100% - {a63.surface.tint}), {a63.brand.50} {a63.surface.tint} )"
                  }
                },
                "overlay": {
                  "$type": "color",
                  "$value": "{surface.light.1}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.light.1} calc(100% - {a63.surface.tint}), {a63.brand.50} {a63.surface.tint} )"
                  }
                },
                "muted": {
                  "$type": "color",
                  "$value": "{surface.light.3}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.light.3} calc(100% - {a63.surface.tint}), {a63.brand.200} {a63.surface.tint} )"
                  }
                },
                "control": {
                  "$root": {
                    "$type": "color",
                    "$value": "{surface.light.1}",
                    "$extensions": {
                      "io.atom63.derive": "color-mix( in oklab, {surface.light.1} calc(100% - {a63.surface.tint}), {a63.brand.50} {a63.surface.tint} )"
                    },
                    "$description": "Recessed input surface (the field fill). Brightest surface in light mode so a\nfield reads as a clean well recessed into its panel via --a63-field-shadow."
                  },
                  "hover": {
                    "$type": "color",
                    "$value": "{surface.light.4}",
                    "$extensions": {
                      "io.atom63.derive": "color-mix( in srgb, color-mix( in oklab, {surface.light.4} calc(100% - {a63.surface.tint}), {a63.brand.300} {a63.surface.tint} ), transparent 20% )"
                    },
                    "$description": "Translucent hover plate. The BASE bends toward the brand hue by the surface\ntint (same surface-4 -> brand-300 step as --a63-border-subtle) so it stays in\nfamily on tinted themes instead of reading as a raw neutral grey; the outer\nmix keeps the 20% translucency (value-identical at tint 0)."
                  }
                },
                "sidebar": {
                  "$type": "color",
                  "$value": "{a63.surface.muted}",
                  "$description": "The sidebar surface (shadcn `sidebar`): the muted surface in light mode and\nthe page surface in dark mode."
                }
              },
              "text": {
                "primary": {
                  "$type": "color",
                  "$value": "{surface.light.12}",
                  "$description": "Text"
                },
                "secondary": {
                  "$type": "color",
                  "$value": "{surface.light.11}"
                },
                "accent": {
                  "$type": "color",
                  "$value": "{a63.brand.text}",
                  "$description": "The brand as text (links, accents) on light surfaces; brand.css picks the\nramp step per brand. Use --a63-action-primary for fills."
                },
                "danger": {
                  "$type": "color",
                  "$value": "{color.danger.600}",
                  "$description": "Danger text: error messages and destructive labels on surfaces. Step 600 on\nlight surfaces; --a63-action-danger stays the fill for danger buttons."
                }
              },
              "border": {
                "subtle": {
                  "$type": "color",
                  "$value": "{surface.light.4}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.light.4} calc(100% - {a63.surface.tint}), {a63.brand.300} {a63.surface.tint} )"
                  },
                  "$description": "Border"
                },
                "control": {
                  "$type": "color",
                  "$value": "{surface.light.5}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.light.5} calc(100% - {a63.surface.tint}), {a63.brand.400} {a63.surface.tint} )"
                  }
                }
              },
              "focus-ring": {
                "$type": "color",
                "$value": "{a63.brand.600}",
                "$description": "The keyboard focus ring. WCAG 1.4.11 needs 3:1 against the control and the\npage around it; step 600 reaches that on every brand's light surfaces (the\ntranslucent 500 it replaced was about 1.4:1)."
              },
              "action": {
                "neutral": {
                  "$root": {
                    "$type": "color",
                    "$value": "{surface.light.12}",
                    "$description": "Action — primary lives in tokens/brand-action.css (brand-ramp scoped).\nNeutral = the default variant's fill; sourced from surfaces (NOT --a63-text-*)\nso a theme can recolor text without turning the default button into a fill."
                  },
                  "foreground": {
                    "$type": "color",
                    "$value": "{surface.light.2}"
                  }
                },
                "danger": {
                  "$root": {
                    "$type": "color",
                    "$value": "{color.danger.600}"
                  },
                  "hover": {
                    "$type": "color",
                    "$value": "{a63.action.danger}",
                    "$extensions": {
                      "io.atom63.derive": "color-mix(in oklch, {a63.action.danger} 90%, transparent)"
                    }
                  },
                  "foreground": {
                    "$type": "color",
                    "$value": "{color.white.100}",
                    "$extensions": {
                      "io.atom63.derive": "white"
                    }
                  }
                }
              },
              "status": {
                "info": {
                  "$root": {
                    "$type": "color",
                    "$value": "{color.info.600}",
                    "$description": "Status (danger's status role is served by --a63-action-danger). The base is\nthe accent used for tinted callouts (bg = mix toward transparent, text/border\n= the accent); -foreground is the text/icon color ON a SOLID status fill.\nStep 600 on light surfaces and 500 on dark ones (the .dark block), so icons\ndrawn in the accent reach WCAG's 3:1 for graphics in both modes."
                  },
                  "foreground": {
                    "$type": "color",
                    "$value": "{a63.status.info}",
                    "$description": "Text and icons on a solid fill of this status. Same auto-contrast step as\nthe primary foreground: near-black on bright fills, near-white on dark ones.",
                    "$extensions": {
                      "io.atom63.derive": "oklch(from {a63.status.info} clamp(0.15, (0.57 - l) * 1000, 0.985) calc(c * 0.06) h)"
                    }
                  }
                },
                "success": {
                  "$root": {
                    "$type": "color",
                    "$value": "{color.success.600}"
                  },
                  "foreground": {
                    "$type": "color",
                    "$value": "{a63.status.success}",
                    "$description": "Text and icons on a solid fill of this status. Same auto-contrast step as\nthe primary foreground: near-black on bright fills, near-white on dark ones.",
                    "$extensions": {
                      "io.atom63.derive": "oklch(from {a63.status.success} clamp(0.15, (0.57 - l) * 1000, 0.985) calc(c * 0.06) h)"
                    }
                  }
                },
                "warning": {
                  "$root": {
                    "$type": "color",
                    "$value": "{color.warning.600}"
                  },
                  "foreground": {
                    "$type": "color",
                    "$value": "{a63.status.warning}",
                    "$description": "Text and icons on a solid fill of this status. Same auto-contrast step as\nthe primary foreground: near-black on bright fills, near-white on dark ones.",
                    "$extensions": {
                      "io.atom63.derive": "oklch(from {a63.status.warning} clamp(0.15, (0.57 - l) * 1000, 0.985) calc(c * 0.06) h)"
                    }
                  }
                }
              },
              "chart": {
                "2": {
                  "$type": "color",
                  "$value": "{color.teal.500}"
                },
                "3": {
                  "$type": "color",
                  "$value": "{color.amber.500}"
                },
                "4": {
                  "$type": "color",
                  "$value": "{color.violet.500}"
                },
                "5": {
                  "$type": "color",
                  "$value": "{color.rose.500}"
                }
              }
            }
          }
        ],
        "dark": [
          {
            "a63": {
              "surface": {
                "page": {
                  "$type": "color",
                  "$value": "{surface.dark.1}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.dark.1} calc(100% - {a63.surface.tint}), {a63.brand.950} {a63.surface.tint} )"
                  }
                },
                "panel": {
                  "$type": "color",
                  "$value": "{surface.dark.2}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.dark.2} calc(100% - {a63.surface.tint}), {a63.brand.900} {a63.surface.tint} )"
                  }
                },
                "overlay": {
                  "$type": "color",
                  "$value": "{surface.dark.4}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.dark.4} calc(100% - {a63.surface.tint}), {a63.brand.800} {a63.surface.tint} )"
                  }
                },
                "muted": {
                  "$type": "color",
                  "$value": "{surface.dark.3}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.dark.3} calc(100% - {a63.surface.tint}), {a63.brand.800} {a63.surface.tint} )"
                  }
                },
                "control": {
                  "$root": {
                    "$type": "color",
                    "$value": "{surface.dark.1}",
                    "$extensions": {
                      "io.atom63.derive": "color-mix( in oklab, {surface.dark.1} calc(100% - {a63.surface.tint}), {a63.brand.950} {a63.surface.tint} )"
                    },
                    "$description": "Recessed input surface — darkest surface in dark mode, so a field reads as a\nsunken well relative to its panel."
                  },
                  "hover": {
                    "$type": "color",
                    "$value": "{surface.dark.6}",
                    "$extensions": {
                      "io.atom63.derive": "color-mix( in srgb, color-mix( in oklab, {surface.dark.6} calc(100% - {a63.surface.tint}), {a63.brand.600} {a63.surface.tint} ), transparent 20% )"
                    },
                    "$description": "Tint-aware translucent hover plate (dark) — surface-6 -> brand-600, matching\n--a63-border-subtle; outer mix keeps the 20% translucency."
                  }
                },
                "sidebar": {
                  "$type": "color",
                  "$value": "{a63.surface.page}"
                }
              },
              "text": {
                "primary": {
                  "$type": "color",
                  "$value": "{surface.dark.12}"
                },
                "secondary": {
                  "$type": "color",
                  "$value": "{surface.dark.11}"
                },
                "accent": {
                  "$type": "color",
                  "$value": "{a63.brand.400}",
                  "$description": "The primary fill is too dark to read as text on dark surfaces."
                },
                "danger": {
                  "$type": "color",
                  "$value": "{color.danger.400}",
                  "$description": "Danger text on dark surfaces: step 400 reaches WCAG AA 4.5:1 on every theme's\ndark page and panel (step 600, the fill, is about 2.7:1 there)."
                }
              },
              "border": {
                "subtle": {
                  "$type": "color",
                  "$value": "{surface.dark.6}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.dark.6} calc(100% - {a63.surface.tint}), {a63.brand.600} {a63.surface.tint} )"
                  }
                },
                "control": {
                  "$type": "color",
                  "$value": "{surface.dark.7}",
                  "$extensions": {
                    "io.atom63.derive": "color-mix( in oklab, {surface.dark.7} calc(100% - {a63.surface.tint}), {a63.brand.500} {a63.surface.tint} )"
                  }
                }
              },
              "focus-ring": {
                "$type": "color",
                "$value": "{a63.brand.400}",
                "$description": "Step 400 on dark surfaces: 600 and some brands' 500 fall below 3:1 there."
              },
              "action": {
                "neutral": {
                  "$root": {
                    "$type": "color",
                    "$value": "{surface.dark.12}"
                  },
                  "foreground": {
                    "$type": "color",
                    "$value": "{surface.dark.1}"
                  }
                },
                "danger": {
                  "hover": {
                    "$type": "color",
                    "$value": "{a63.action.danger}",
                    "$extensions": {
                      "io.atom63.derive": "color-mix(in oklch, {a63.action.danger} 82%, white 8%)"
                    }
                  }
                }
              },
              "status": {
                "info": {
                  "$type": "color",
                  "$value": "{color.info.500}"
                },
                "success": {
                  "$type": "color",
                  "$value": "{color.success.500}"
                },
                "warning": {
                  "$type": "color",
                  "$value": "{color.warning.500}"
                }
              },
              "chart": {
                "2": {
                  "$type": "color",
                  "$value": "{color.teal.400}"
                },
                "3": {
                  "$type": "color",
                  "$value": "{color.amber.400}"
                },
                "4": {
                  "$type": "color",
                  "$value": "{color.violet.400}"
                },
                "5": {
                  "$type": "color",
                  "$value": "{color.rose.400}"
                }
              }
            }
          }
        ]
      }
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/mode"
    }
  ],
  "$extensions": {
    "io.atom63.css": {
      "attribute": "data-a63-mode",
      "selectors": {
        "light": ":root,\n.light,\n[data-a63-mode='light']",
        "dark": ":is(.dark, [data-a63-mode='dark'])"
      }
    }
  }
}
