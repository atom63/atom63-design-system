{
  "name": "@atom63/ui-react",
  "version": "0.2.0-beta.2",
  "description": "React components, layout primitives, media, and theme controls for the Atom63 design system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATOM63/atom63-design-system.git",
    "directory": "packages/ui-react"
  },
  "homepage": "https://github.com/ATOM63/atom63-design-system/tree/main/packages/ui-react#readme",
