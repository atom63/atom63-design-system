{
  "name": "@atom63/figma",
  "version": "0.1.0-beta.0",
  "description": "Sync design tokens between code and Figma variables: the sync engine, a token CSS reader, and scripts an agent runs through the Figma MCP server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atom63/atom63-design-system.git",
    "directory": "packages/figma"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atom63-figma": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "@atom63/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "@atom63/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:runtime": "tsup src/runtime.ts src/runtime-components.ts --format iife --global-name A63Figma --minify --platform neutral --target es2020 --out-dir dist/runtime --no-dts --no-sourcemap && node scripts/embed-runtime.mjs",
    "build": "pnpm embed:template && pnpm build:runtime && tsup",
    "embed:template": "node scripts/embed-template.mjs",
    "template:pull": "node scripts/pull-template.mjs",
    "generate:components": "node --disable-warning=ExperimentalWarning scripts/generate-components.mjs",
    "check:components": "node --disable-warning=ExperimentalWarning scripts/generate-components.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --max-warnings 0",
    "pretest": "pnpm build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@atom63/eslint-config": "workspace:*",
    "@atom63/tsconfig": "workspace:*",
    "@types/node": "^26.3.0",
    "eslint": "10.7.0",
    "tsup": "^8.3.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
