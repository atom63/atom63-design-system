{
  "name": "@atom63/cli",
  "version": "0.1.0-beta.0",
  "description": "Query the Atom63 design system from the command line or an MCP host: components, contracts, tokens, examples and docs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atom63/atom63-design-system.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "atom63": "./src/bin.mjs"
  },
  "exports": {
    ".": "./src/core.mjs",
    "./agents-md": "./src/agents-md.mjs",
    "./agent-index.json": "./generated/agent-index.json"
  },
  "files": [
    "generated",
    "src",
    "!src/**/*.test.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:index": "node scripts/build-index.mjs",
    "check:index": "node scripts/build-index.mjs --check",
    "test": "node --test \"src/**/*.test.mjs\"",
    "sync:agents-md": "node scripts/sync-agents-md.mjs",
    "check:agents-md": "node scripts/sync-agents-md.mjs --check"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "vite": "catalog:"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "^4.6.5"
  }
}
