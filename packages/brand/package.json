{
  "name": "@atom63/brand",
  "version": "0.3.0-beta.0",
  "private": true,
  "description": "The ATOM63 logo components, for this repo's docs site and Storybook (not published)",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atom63/atom63-design-system.git",
    "directory": "packages/brand"
  },
  "homepage": "https://github.com/atom63/atom63-design-system/tree/main/packages/brand#readme",
  "bugs": {
    "url": "https://github.com/atom63/atom63-design-system/issues"
  },
  "keywords": [
