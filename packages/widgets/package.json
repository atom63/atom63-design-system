{
  "name": "@atom63/widgets",
  "version": "0.1.0-beta.1",
  "description": "The Atom63 widget foundation: widget units and scale, the widget card and surface, loading, empty and error states, and the hosted shell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atom63/atom63-design-system.git",
    "directory": "packages/widgets"
  },
  "homepage": "https://github.com/atom63/atom63-design-system/tree/main/packages/widgets#readme",
  "bugs": {
    "url": "https://github.com/atom63/atom63-design-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "atom63",
    "design-system",
    "widgets",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@atom63/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "@atom63/source": "./src/primitives/index.ts",
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./state": {
      "@atom63/source": "./src/state/index.ts",
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    },
    "./runtime": {
      "@atom63/source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@atom63/ui-react": "workspace:*",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@atom63/eslint-config": "workspace:*",
    "@atom63/tsconfig": "workspace:*",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "^26.3.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "^4.12.1",
    "eslint": "10.7.0",
    "jsdom": "catalog:",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.6.0",
    "tsup": "^8.3.5",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "^0.1.0"
  }
}
