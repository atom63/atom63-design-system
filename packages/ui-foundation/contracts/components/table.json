{
  "$schema": "../schema/component-intent.schema.json",
  "component": "table",
  "maturity": "stable",
  "description": "The tabular-data set: a horizontally scrollable container around a semantic <table>. The container takes size (default/sm) and variant (default/plain); TableHead and TableCell can pin to the start or end edge. The DS recipe reads these off data-size / data-variant / data-sticky.",
  "lists": {
    "variants": ["default", "plain"],
    "sizes": ["default", "sm"],
    "stickyEdges": ["start", "end"],
    "states": ["rest", "row-hover", "row-selected"],
    "slots": [
      "table-container",
      "table",
      "table-header",
      "table-body",
      "table-footer",
      "table-row",
      "table-head",
      "table-cell",
      "table-caption"
    ],
    "visualArchetypes": ["surface"]
  },
  "contract": {
    "defaultVariant": "default",
    "defaultSize": "default",
    "variants": {
      "$ref": "#/lists/variants"
    },
    "sizes": {
      "$ref": "#/lists/sizes"
    },
    "stickyEdges": {
      "$ref": "#/lists/stickyEdges"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  }
}
