{
  "$schema": "../schema/component-intent.schema.json",
  "component": "toggle",
  "maturity": "stable",
  "lists": {
    "sizes": ["sm", "md", "lg"],
    "tones": ["neutral", "accent", "subtle"],
    "states": {
      "values": ["off", "on", "rest", "hover", "pressed", "disabled", "focus-visible"],
      "deprecatedAliases": {
        "focus": "focus-visible"
      }
    },
    "slots": ["toggle", "toggle-content"],
    "tokenSlots": [
      "toggle.background",
      "toggle.foreground",
      "toggle.hoverBackground",
      "toggle.onBackground",
      "toggle.onForeground",
      "toggle.primaryBackground",
      "toggle.primaryForeground",
      "toggle.borderWidth",
      "toggle.radius",
      "toggle.gloss",
      "toggle.shadow",
      "toggle.shadowActive",
      "toggle.textShadow"
    ],
    "visualArchetypes": ["toggle"]
  },
  "contract": {
    "defaultSize": "md",
    "defaultTone": "neutral",
    "sizes": {
      "$ref": "#/lists/sizes"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "tokenSlots": {
      "$ref": "#/lists/tokenSlots"
    },
    "tones": {
      "$ref": "#/lists/tones"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  },
  "intent": {
    "description": "What a toggle is, independent of any platform: its size and the tone of its pressed state. iOS has neither axis: AtomChip takes isSelected only, at one touch size and tint.",
    "axes": {
      "size": ["sm", "md", "lg"],
      "tone": ["neutral", "accent", "subtle"]
    },
    "platforms": {
      "web": {
        "props": {
          "size": {
            "list": "sizes",
            "map": {
              "sm": {
                "size": "sm"
              },
              "md": {
                "size": "md"
              },
              "lg": {
                "size": "lg"
              }
            },
            "extensions": {}
          },
          "tone": {
            "list": "tones",
            "map": {
              "neutral": {
                "tone": "neutral"
              },
              "accent": {
                "tone": "accent"
              },
              "subtle": {
                "tone": "subtle"
              }
            },
            "extensions": {}
          }
        }
      }
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "chip",
    "reactRenderer": "Toggle",
    "swiftUIRenderer": "AtomChip",
    "intent": "Select or deselect a compact option without leaving the current context.",
    "parity": "platform-adaptive",
    "requiredStates": ["off", "on", "disabled"],
    "sharedOutcomes": [
      "selected-state-is-visible",
      "activation-toggles-selection",
      "disabled-prevents-change"
    ],
    "accessibilityOutcomes": ["exposes-label", "announces-selected-state", "preserves-button-role"],
    "platformAdaptations": {
      "react": [
        "Uses a pressed-state web toggle with hover and focus-visible feedback.",
        "The subtle tone (accent color, no fill) is web-only."
      ],
      "swiftUI": ["Uses a touch-sized button-backed chip for compact filter selection."]
    }
  }
}
