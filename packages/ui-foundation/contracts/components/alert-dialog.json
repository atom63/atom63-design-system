{
  "$schema": "../schema/component-intent.schema.json",
  "component": "alert-dialog",
  "maturity": "stable",
  "lists": {
    "variants": {
      "values": ["default", "error", "info", "success", "warning"],
      "deprecatedAliases": {
        "destructive": "error"
      }
    },
    "footerVariants": ["default", "bare"],
    "sizes": {
      "values": ["md", "sm"],
      "deprecatedAliases": {
        "default": "md"
      }
    },
    "states": ["closed", "open"],
    "slots": [
      "alert-dialog-portal",
      "alert-dialog-trigger",
      "alert-dialog-backdrop",
      "alert-dialog-viewport",
      "alert-dialog-popup",
      "alert-dialog-header",
      "alert-dialog-footer",
      "alert-dialog-media",
      "alert-dialog-title",
      "alert-dialog-description",
      "alert-dialog-close",
      "alert-dialog-action",
      "alert-dialog-cancel"
    ],
    "visualArchetypes": ["overlay", "surface", "trigger", "action"]
  },
  "contract": {
    "accessibility": {
      "pattern": "alertdialog"
    },
    "defaultFooterVariant": "default",
    "defaultSize": "md",
    "defaultVariant": "default",
    "footerVariants": {
      "$ref": "#/lists/footerVariants"
    },
    "sizes": {
      "$ref": "#/lists/sizes"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "variants": {
      "$ref": "#/lists/variants"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  },
  "intent": {
    "description": "What an alert dialog is, independent of any platform: the tone of the consequence it asks about, its width step and its footer chrome. iOS has none of these axes: the system alert(_:isPresented:actions:message:) draws one style, and a destructive action is a Button with role .destructive.",
    "axes": {
      "tone": ["neutral", "error", "info", "success", "warning"],
      "size": ["md", "sm"],
      "footer": ["default", "bare"]
    },
    "platforms": {
      "web": {
        "props": {
          "variant": {
            "list": "variants",
            "map": {
              "default": {
                "tone": "neutral"
              },
              "error": {
                "tone": "error"
              },
              "info": {
                "tone": "info"
              },
              "success": {
                "tone": "success"
              },
              "warning": {
                "tone": "warning"
              }
            },
            "extensions": {}
          },
          "size": {
            "list": "sizes",
            "map": {
              "md": {
                "size": "md"
              },
              "sm": {
                "size": "sm"
              }
            },
            "extensions": {}
          },
          "footerVariant": {
            "list": "footerVariants",
            "map": {
              "default": {
                "footer": "default"
              },
              "bare": {
                "footer": "bare"
              }
            },
            "extensions": {}
          }
        }
      }
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "confirmationDialog",
    "reactRenderer": "AlertDialog",
    "swiftUIRenderer": "alert(_:isPresented:actions:message:)",
    "intent": "Require an explicit decision before committing or abandoning a consequential action.",
    "parity": "platform-adaptive",
    "requiredStates": ["closed", "open"],
    "sharedOutcomes": [
      "consequential-action-requires-explicit-confirmation",
      "cancel-dismisses-without-performing-the-action",
      "confirmation-performs-the-action-once-and-dismisses"
    ],
    "accessibilityOutcomes": [
      "exposes-alert-dialog-title",
      "exposes-consequence-description",
      "identifies-cancel-and-confirm-actions"
    ],
    "platformAdaptations": {
      "react": [
        "Uses an alertdialog portal with guarded outside and Escape dismissal plus explicit action and cancel controls."
      ],
      "swiftUI": [
        "Uses a native alert or confirmationDialog with platform button roles, ordering, and compact presentation."
      ]
    }
  }
}
