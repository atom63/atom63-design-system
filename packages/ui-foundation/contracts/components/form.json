{
  "$schema": "../schema/component-intent.schema.json",
  "component": "form",
  "maturity": "stable",
  "lists": {
    "slots": ["form-item", "form-label", "form-description", "form-message"],
    "states": {
      "values": ["rest", "invalid"],
      "deprecatedAliases": {
        "default": "rest"
      }
    },
    "visualArchetypes": ["field"]
  },
  "contract": {
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  }
}
