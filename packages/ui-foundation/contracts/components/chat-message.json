      "chat-message-body",
      "chat-message-content",
      "chat-message-actions"
    ],
    "states": ["rest", "streaming"],
    "visualArchetypes": ["surface"]
  },
  "contract": {
    "roles": {
      "$ref": "#/lists/roles"
    },
    "defaultAppearance": "plain",
    "appearances": {
      "$ref": "#/lists/appearances"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  }
}
