{
  "$schema": "../schema/component-intent.schema.json",
  "component": "radio",
  "maturity": "stable",
  "lists": {
    "sizes": ["sm", "md"],
    "indicators": ["visible", "hidden"],
    "states": ["unchecked", "checked", "focus-visible", "disabled", "invalid"],
    "slots": ["radio-group", "radio", "radio-indicator"],
    "visualArchetypes": ["choice"]
  },
  "contract": {
    "accessibility": {
      "pattern": "radio"
    },
    "defaultSize": "md",
    "defaultIndicator": "visible",
    "sizes": {
      "$ref": "#/lists/sizes"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    },
    "indicators": {
      "$ref": "#/lists/indicators"
    }
  },
  "intent": {
    "description": "What a radio is, independent of any platform: its size and whether its indicator is drawn. iOS has neither axis: Picker(.inline) and AtomSelectionRow draw a checkmark row at one size.",
    "axes": {
      "size": ["sm", "md"],
      "indicator": ["visible", "hidden"]
    },
    "platforms": {
      "web": {
        "props": {
          "size": {
            "list": "sizes",
            "map": {
              "sm": {
                "size": "sm"
              },
              "md": {
                "size": "md"
              }
            },
            "extensions": {}
          },
          "indicator": {
            "list": "indicators",
            "map": {
              "visible": {
                "indicator": "visible"
              },
              "hidden": {
                "indicator": "hidden"
              }
            },
            "extensions": {}
          }
        }
      }
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "radioGroup",
    "reactRenderer": "RadioGroup / Radio",
    "swiftUIRenderer": "Picker(.inline) in a Form / AtomSelectionRow group",
    "intent": "Choose exactly one value from a visible set of mutually exclusive options.",
    "parity": "platform-adaptive",
    "requiredStates": ["unchecked", "checked", "disabled"],
    "sharedOutcomes": [
      "exactly-one-option-may-be-selected",
      "activation-moves-selection-to-the-chosen-option",
      "disabled-option-prevents-selection"
    ],
    "accessibilityOutcomes": [
      "exposes-group-label",
      "exposes-option-labels-and-selected-state",
      "preserves-single-selection-semantics"
    ],
    "platformAdaptations": {
      "react": [
        "Uses radiogroup and radio semantics with circular indicators and keyboard movement."
      ],
      "swiftUI": [
        "Uses an inline Picker inside a Form or List, where each option is a row with the native selected trait (outside one, iOS draws a wheel), or grouped AtomSelectionRow controls."
      ]
    }
  }
}
