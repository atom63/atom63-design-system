  "lists": {
    "kinds": ["empty", "error", "loading", "not-found", "no-results", "offline", "stale"],
    "sizes": ["inline", "panel", "page", "widget"],
    "slots": [
      "feedback-state",
      "feedback-state-header",
      "feedback-state-media",
      "feedback-state-title",
      "feedback-state-description",
      "feedback-state-content"
    ],
    "states": ["idle", "busy", "actionable"],
    "visualArchetypes": ["action"]
  },
  "contract": {
    "defaultKind": "empty",
    "defaultSize": "panel",
    "kinds": {
      "$ref": "#/lists/kinds"
    },
    "sizes": {
      "$ref": "#/lists/sizes"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  }
}
