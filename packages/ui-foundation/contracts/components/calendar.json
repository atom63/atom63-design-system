      "selected-date-exposes-selected-state"
    ],
    "platformAdaptations": {
      "react": [
        "Uses a visible calendar grid and may support single, multiple, or range selection."
      ],
      "swiftUI": [
        "Uses DatePicker with platform-owned compact, graphical, or field presentation and declared date bounds."
      ]
