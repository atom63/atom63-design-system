    "slots": [
      "calendar",
      "calendar-months",
      "calendar-month",
      "calendar-month-caption",
      "calendar-caption-label",
      "calendar-nav",
      "calendar-nav-button",
      "calendar-chevron",
      "calendar-dropdowns",
      "calendar-dropdown-root",
      "calendar-dropdown",
      "calendar-weekday",
      "calendar-week-number",
      "calendar-day",
      "calendar-day-button"
    ],
    "states": [
      "rest",
      "hover",
      "focus-visible",
      "today",
      "selected",
      "range-start",
      "range-middle",
      "range-end",
      "outside",
      "disabled"
    ],
    "visualArchetypes": ["surface", "action", "choice"]
