{
  "$schema": "../schema/component-intent.schema.json",
  "component": "button-group",
  "description": "Faithful to prod @atom63/ui button-group: horizontal|vertical orientation and the full text/icon size ramp. Sizes drive the welded control heights; the text sizes (xs..xl) size the text/label runs, the icon-* sizes make square icon-button runs. The DS recipe reads these off data-orientation / data-size.",
  "lists": {
    "orientations": ["horizontal", "vertical"],
    "sizes": [
      "xs",
      "sm",
      "default",
      "lg",
      "xl",
      "icon-xs",
      "icon-sm",
      "icon",
      "icon-lg",
      "icon-xl"
    ],
    "slots": ["button-group", "button-group-text", "button-group-separator"],
    "states": ["rest", "focus-within"],
    "visualArchetypes": ["action", "segment"]
  },
  "contract": {
    "defaultOrientation": "horizontal",
    "defaultSize": "default",
    "orientations": {
      "$ref": "#/lists/orientations"
    },
    "sizes": {
      "$ref": "#/lists/sizes"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  }
}
