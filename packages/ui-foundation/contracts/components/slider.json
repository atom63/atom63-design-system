{
  "$schema": "../schema/component-intent.schema.json",
  "component": "slider",
  "maturity": "stable",
  "lists": {
    "orientations": ["horizontal", "vertical"],
    "modes": ["single", "range"],
    "tones": ["accent", "neutral"],
    "states": ["rest", "focus-visible", "dragging", "disabled"],
    "slots": [
      "slider",
      "slider-value",
      "slider-control",
      "slider-track",
      "slider-indicator",
      "slider-thumb"
    ],
    "visualArchetypes": ["range"]
  },
  "contract": {
    "defaultOrientation": "horizontal",
    "defaultTone": "accent",
    "orientations": {
      "$ref": "#/lists/orientations"
    },
    "modes": {
      "$ref": "#/lists/modes"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    },
    "tones": {
      "$ref": "#/lists/tones"
    }
  },
  "intent": {
    "description": "What a slider is, independent of any platform: its direction, whether it picks one value or a range, and the tone of its track. atomSliderTone(_:) takes the tone on iOS; the native Slider is horizontal and single-valued only, so iOS has no orientation or mode axis.",
    "axes": {
      "orientation": ["horizontal", "vertical"],
      "mode": ["single", "range"],
      "tone": ["accent", "neutral"]
    },
    "platforms": {
      "web": {
        "props": {
          "orientation": {
            "list": "orientations",
            "map": {
              "horizontal": {
                "orientation": "horizontal"
              },
              "vertical": {
                "orientation": "vertical"
              }
            },
            "extensions": {}
          },
          "mode": {
            "list": "modes",
            "map": {
              "single": {
                "mode": "single"
              },
              "range": {
                "mode": "range"
              }
            },
            "extensions": {}
          },
          "tone": {
            "list": "tones",
            "map": {
              "accent": {
                "tone": "accent"
              },
              "neutral": {
                "tone": "neutral"
              }
            },
            "extensions": {}
          }
        }
      },
      "ios": {
        "props": {
          "tone": {
            "swiftEnum": "AtomTrackTone",
            "map": {
              "accent": {
                "tone": "accent"
              },
              "neutral": {
                "tone": "neutral"
              }
            },
            "extensions": {}
          }
        }
      }
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "slider",
    "reactRenderer": "Slider",
    "swiftUIRenderer": "Slider",
    "intent": "Adjust a bounded numeric value through direct manipulation or assistive increment and decrement actions.",
    "parity": "platform-adaptive",
    "requiredStates": ["rest", "dragging", "disabled"],
    "sharedOutcomes": [
      "value-remains-within-the-declared-range",
      "interaction-updates-value-using-the-declared-step",
      "disabled-control-prevents-value-change"
    ],
    "accessibilityOutcomes": [
      "exposes-label",
      "exposes-current-value-and-range",
      "supports-adjustable-actions"
    ],
    "platformAdaptations": {
      "react": [
        "Supports horizontal or vertical orientation and optional multi-thumb ranges through web pointer and keyboard input."
      ],
      "swiftUI": [
        "Uses the native horizontal Slider with platform drag, keyboard, and accessibility-adjustable behavior.",
        "atomSliderTone(_:) keeps accent as the default and uses primary text for the neutral tint."
      ]
    }
  }
}
