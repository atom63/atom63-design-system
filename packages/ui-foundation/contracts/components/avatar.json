{
  "$schema": "../schema/component-intent.schema.json",
  "component": "avatar",
  "maturity": "stable",
  "description": "The fallback holds initials or one icon (an assistant's sparkle, an app glyph) in a filled circle; an icon is drawn at the control icon size for the size step. A ring marks a story or new activity: unseen draws --a63-avatar-ring-fill (the accent unless a product sets it, for example to a gradient of the category palette) set off from the face by a gap of the page surface; seen draws a thin border-coloured ring.",
  "lists": {
    "sizes": {
      "values": ["xs", "sm", "md", "lg"],
      "deprecatedAliases": {
        "default": "md"
      }
    },
    "shapes": ["circle", "square"],
    "states": ["loading", "loaded", "fallback"],
    "compositions": ["standalone", "badge", "group"],
    "rings": ["unseen", "seen"],
    "slots": [
      "avatar",
      "avatar-image",
      "avatar-fallback",
      "avatar-badge",
      "avatar-group",
      "avatar-group-count"
    ],
    "visualArchetypes": ["marker"]
  },
  "contract": {
    "defaultShape": "circle",
    "defaultSize": "md",
    "compositions": {
      "$ref": "#/lists/compositions"
    },
    "rings": {
      "$ref": "#/lists/rings"
    },
    "shapes": {
      "$ref": "#/lists/shapes"
    },
    "sizes": {
      "$ref": "#/lists/sizes"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  },
  "intent": {
    "description": "What an avatar ring says, independent of any platform: whether the story behind it is unseen or seen.",
    "axes": {
      "ring": ["unseen", "seen"]
    },
    "platforms": {
      "web": {
        "props": {
          "ring": {
            "list": "rings",
            "map": {
              "unseen": {
                "ring": "unseen"
              },
              "seen": {
                "ring": "seen"
              }
            },
            "extensions": {}
          }
        }
      },
      "ios": {
        "props": {
          "ring": {
            "swiftEnum": "AtomAvatarRing",
            "map": {
              "unseen": {
                "ring": "unseen"
              },
              "seen": {
                "ring": "seen"
              }
            },
            "extensions": {}
          }
        }
      }
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "avatar",
    "reactRenderer": "Avatar",
    "swiftUIRenderer": "AtomAvatar",
    "intent": "Represent a person or entity with an image and identity-preserving fallback.",
    "parity": "strict",
    "requiredStates": ["loading", "loaded", "fallback"],
    "sharedOutcomes": [
      "accessible-name-is-preserved",
      "fallback-preserves-identity",
      "loading-does-not-expose-empty-image"
    ],
    "accessibilityOutcomes": ["exposes-accessible-name", "fallback-preserves-identity"],
    "platformAdaptations": {
      "react": [
        "Uses browser image loading and DOM fallback composition.",
        "The square shape and the ring are web-only for now."
      ],
      "swiftUI": [
        "Uses native image decoding and SwiftUI loading phases.",
        "AtomAvatar(badge:) pins a status dot (.dot) or a count (.count) to the corner, read after the name."
      ]
    }
  }
}
