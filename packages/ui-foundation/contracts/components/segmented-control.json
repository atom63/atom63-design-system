{
  "$schema": "../schema/component-intent.schema.json",
  "component": "segmented-control",
  "maturity": "stable",
  "lists": {
    "sizes": ["sm", "md", "lg"],
    "variants": ["icon", "label"],
    "tones": ["neutral", "accent"],
    "states": ["rest", "hover", "selected", "disabled", "focus-visible"],
    "slots": [
      "segmented-control",
      "segmented-control-track",
      "segmented-control-item",
      "segmented-control-icon",
      "segmented-control-label",
      "segmented-control-indicator"
    ],
    "visualArchetypes": ["segment"]
  },
  "contract": {
    "defaultSize": "md",
    "defaultTone": "neutral",
    "defaultVariant": "label",
    "sizes": {
      "$ref": "#/lists/sizes"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "tones": {
      "$ref": "#/lists/tones"
    },
    "variants": {
      "$ref": "#/lists/variants"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  },
  "intent": {
    "description": "What a segmented control is, independent of any platform: its size, whether segments show icons or labels, and the tone of the selected segment. iOS has none of these axes: Picker(.segmented) draws at the platform size and tint, and a segment is whatever label view it is given.",
    "axes": {
      "size": ["sm", "md", "lg"],
      "content": ["icon", "label"],
      "tone": ["neutral", "accent"]
    },
    "platforms": {
      "web": {
        "props": {
          "size": {
            "list": "sizes",
            "map": {
              "sm": {
                "size": "sm"
              },
              "md": {
                "size": "md"
              },
              "lg": {
                "size": "lg"
              }
            },
            "extensions": {}
          },
          "variant": {
            "list": "variants",
            "map": {
              "icon": {
                "content": "icon"
              },
              "label": {
                "content": "label"
              }
            },
            "extensions": {}
          },
          "tone": {
            "list": "tones",
            "map": {
              "neutral": {
                "tone": "neutral"
              },
              "accent": {
                "tone": "accent"
              }
            },
            "extensions": {}
          }
        }
      }
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "segmentedControl",
    "reactRenderer": "SegmentedControl",
    "swiftUIRenderer": "Picker(.segmented)",
    "intent": "Switch a compact local mode or view between a small set of mutually exclusive options.",
    "parity": "platform-adaptive",
    "requiredStates": ["rest", "selected", "disabled"],
    "sharedOutcomes": [
      "one-segment-is-selected-at-a-time",
      "activation-updates-the-selection-once",
      "disabled-segment-prevents-selection"
    ],
    "accessibilityOutcomes": [
      "exposes-each-segment-label",
      "exposes-selected-state",
      "preserves-single-selection-semantics"
    ],
    "platformAdaptations": {
      "react": [
        "Uses radiogroup and radio semantics on a segmented track, named by aria-label or aria-labelledby, with arrow-key selection, focus-visible feedback and an optional animated selection backplate."
      ],
      "swiftUI": [
        "Uses Picker with segmented style so geometry, typography, and selection feedback remain platform-native."
      ]
    }
  }
}
