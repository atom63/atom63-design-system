{
  "$schema": "../schema/component-intent.schema.json",
  "component": "toggle-group",
  "maturity": "stable",
  "description": "`segmented` (default) welds the items into one bar; `pills` draws each item as a separate filled capsule with a gap, for filter rows such as Playlists / Artists / Albums; `ghost` leaves the items as plain text and gives only the selected one a soft fill, for quiet filters in a toolbar such as All / Read / Unread.",
  "lists": {
    "variants": ["segmented", "pills", "ghost"],
    "orientations": ["horizontal", "vertical"],
    "selectionModes": ["single", "multiple"],
    "states": ["rest", "hover", "focus", "selected", "disabled"],
    "slots": ["toggle-group", "toggle-group-item", "toggle-group-separator"],
    "tokenSlots": [
      "segment.gap",
      "segment.radius",
      "segment.background",
      "segment.gloss",
      "segment.trackBorder",
      "segment.seam",
      "segment.selectedBackground",
      "segment.selectedForeground",
      "segment.selectedGloss",
      "segment.selectedShadow",
      "segment.primaryBackground",
      "segment.primaryForeground",
      "segment.primaryShadow"
    ],
    "visualArchetypes": ["toggle", "segment"]
  },
  "contract": {
    "defaultVariant": "segmented",
    "defaultOrientation": "horizontal",
    "defaultSelectionMode": "single",
    "variants": {
      "$ref": "#/lists/variants"
    },
    "orientations": {
      "$ref": "#/lists/orientations"
    },
    "selectionModes": {
      "$ref": "#/lists/selectionModes"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "tokenSlots": {
      "$ref": "#/lists/tokenSlots"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "toggleGroup",
    "reactRenderer": "ToggleGroup",
    "swiftUIRenderer": "Picker(.segmented) / AtomGhostToggleGroup",
    "intent": "Choose one or more options from a compact peer group.",
    "parity": "platform-adaptive",
    "requiredStates": ["rest", "selected", "disabled"],
    "sharedOutcomes": ["selection-state-is-visible", "disabled-options-cannot-change-selection"],
    "accessibilityOutcomes": ["exposes-selection", "exposes-disabled-state"],
    "platformAdaptations": {
      "react": ["Supports segmented, pills, and ghost recipes with horizontal or vertical layout."],
      "swiftUI": [
        "Uses Picker with segmented style for the joined segmented variant.",
        "Uses AtomGhostToggleGroup with AtomGhostToggleGroupItem for quiet toolbar filters; each item remains a native Button with the selected trait."
      ]
    }
  }
}
