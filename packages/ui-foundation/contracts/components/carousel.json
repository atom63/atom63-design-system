{
  "$schema": "../schema/component-intent.schema.json",
  "component": "carousel",
  "maturity": "stable",
  "lists": {
    "orientations": ["horizontal", "vertical"],
    "slots": [
      "carousel",
      "carousel-content",
      "carousel-item",
      "carousel-previous",
      "carousel-next",
      "carousel-cursor",
      "carousel-dots",
      "carousel-dot"
    ],
    "states": ["rest", "hover", "focus-visible", "disabled", "cursor-active", "can-scroll"],
    "visualArchetypes": ["surface", "overlay", "action"]
  },
  "contract": {
    "defaultOrientation": "horizontal",
    "orientations": {
      "$ref": "#/lists/orientations"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "pageDots",
    "reactRenderer": "CarouselDots",
    "swiftUIRenderer": "TabView(.page) / AtomPageDots",
    "intent": "Show which slide of a paged carousel is current, and go to a slide by choosing its dot.",
    "parity": "platform-adaptive",
    "requiredStates": ["rest"],
    "sharedOutcomes": [
      "one-dot-per-slide",
      "current-slide-is-marked",
      "choosing-a-dot-shows-its-slide"
    ],
    "accessibilityOutcomes": ["names-the-indicator", "exposes-the-current-position"],
    "platformAdaptations": {
      "react": [
        "One button per snap point, named \"Slide 2 of 5\"; the current one carries aria-current."
      ],
      "swiftUI": [
        "TabView with .page(indexDisplayMode: .never) pages the slides; AtomPageDots binds to its selection.",
        "VoiceOver reads the dots as one adjustable element; swiping up or down changes the slide."
      ]
    }
  }
}
