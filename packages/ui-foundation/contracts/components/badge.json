{
  "$schema": "../schema/component-intent.schema.json",
  "component": "badge",
  "maturity": "stable",
  "description": "Solid/surface + semantic sets are faithful to prod @atom63/ui badge.tsx. Palette hues back category/tag colors via the `--a63-badge-*` contract in @atom63/styles (which references foundation --color-* primitives).",
  "lists": {
    "solidVariants": {
      "values": [
        "default",
        "primary",
        "secondary",
        "destructive",
        "outline",
        "glass",
        "muted",
        "accent"
      ],
      "typed": false
    },
    "semanticVariants": {
      "values": ["error", "info", "success", "warning"],
      "typed": false
    },
    "paletteVariants": {
      "values": [
        "red",
        "orange",
        "amber",
        "yellow",
        "lime",
        "green",
        "emerald",
        "teal",
        "cyan",
        "sky",
        "blue",
        "indigo",
        "violet",
        "purple",
        "fuchsia",
        "pink",
        "rose",
        "neutral"
      ],
      "typed": false
    },
    "variants": {
      "concat": ["solidVariants", "semanticVariants", "paletteVariants"]
    },
    "sizes": ["sm", "md", "lg"],
    "slots": ["badge"],
    "states": ["resting", "interactive", "disabled", "focus-visible"],
    "visualArchetypes": ["marker"]
  },
  "contract": {
    "defaultVariant": "default",
    "defaultSize": "md",
    "variants": {
      "$ref": "#/lists/variants"
    },
    "sizes": {
      "$ref": "#/lists/sizes"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  },
  "intent": {
    "description": "What a badge says, independent of any platform: its tone (the kind of status or meaning) and its emphasis (how strongly it is drawn). The palette hues are a web extension for categories that carry no status.",
    "axes": {
      "tone": ["neutral", "primary", "info", "success", "warning", "error"],
      "emphasis": ["solid", "soft", "outline"]
    },
    "platforms": {
      "web": {
        "props": {
          "variant": {
            "list": "variants",
            "map": {
              "default": {
                "tone": "neutral",
                "emphasis": "solid"
              },
              "primary": {
                "tone": "primary",
                "emphasis": "solid"
              },
              "secondary": {
                "tone": "neutral",
                "emphasis": "soft"
              },
              "outline": {
                "tone": "neutral",
                "emphasis": "outline"
              },
              "destructive": {
                "tone": "error",
                "emphasis": "solid"
              },
              "error": {
                "tone": "error",
                "emphasis": "soft"
              },
              "info": {
                "tone": "info",
                "emphasis": "soft"
              },
              "success": {
                "tone": "success",
                "emphasis": "soft"
              },
              "warning": {
                "tone": "warning",
                "emphasis": "soft"
              }
            },
            "extensions": {
              "glass": {
                "description": "A translucent surface with a hairline, for badges over imagery."
              },
              "muted": {
                "description": "A quieter neutral on the muted surface."
              },
              "accent": {
                "description": "A neutral on the control hover surface."
              },
              "red": {
                "description": "A palette hue for a category with no status.",
                "group": "hue"
              },
              "orange": {
