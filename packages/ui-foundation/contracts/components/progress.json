{
  "$schema": "../schema/component-intent.schema.json",
  "component": "progress",
  "lists": {
    "states": ["indeterminate", "progressing", "complete"],
    "slots": [
      "progress",
      "progress-label",
      "progress-track",
      "progress-indicator",
      "progress-value"
    ],
    "visualArchetypes": ["range"]
  },
  "contract": {
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "progress",
