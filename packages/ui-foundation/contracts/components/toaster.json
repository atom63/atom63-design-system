{
  "$schema": "../schema/component-intent.schema.json",
  "component": "toaster",
  "maturity": "stable",
  "description": "`default` is a card on the overlay surface with the icon before the message; `inverse` is a compact pill in the inverse colours (dark on a light app, light on a dark one) with the icon after the message, the macOS and iOS look for a short status such as Scheduling message…. The tones are not a Toaster prop: each maps to the function that raises the toast, toast() for default and toast.info, toast.success, toast.warning, toast.error and toast.loading for the rest.",
  "lists": {
    "variants": ["default", "inverse"],
    "states": ["visible", "dismissing", "reduced-motion"],
    "tones": ["default", "info", "success", "warning", "error", "loading"],
    "slots": ["toaster", "toast", "toast-icon", "toast-message"],
    "visualArchetypes": ["surface"]
  },
  "contract": {
    "defaultVariant": "default",
    "variants": {
      "$ref": "#/lists/variants"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "tones": {
      "$ref": "#/lists/tones"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  },
  "intent": {
    "description": "What a toast surface is, independent of any platform: the standard surface or the inverse one. The status tones are web extensions of the toast content.",
    "axes": {
      "variant": ["default", "inverse"]
    },
    "platforms": {
      "web": {
        "props": {
          "variant": {
            "list": "variants",
            "map": {
              "default": {
                "variant": "default"
              },
              "inverse": {
                "variant": "inverse"
              }
            },
            "extensions": {}
          }
        }
      },
      "ios": {
        "props": {
          "variant": {
            "swiftEnum": "AtomToastVariant",
            "map": {
              "default": {
                "variant": "default"
              },
              "inverse": {
                "variant": "inverse"
              }
            },
            "extensions": {}
          }
        }
      }
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "toast",
    "reactRenderer": "Toaster",
    "swiftUIRenderer": "AtomToast / atomToast(_:)",
    "intent": "Announce transient feedback without interrupting the current task.",
    "parity": "recipe",
    "requiredStates": ["visible", "dismissing", "reduced-motion"],
    "sharedOutcomes": [
      "message-is-announced",
      "focus-is-not-trapped",
      "dismissal-respects-motion-preference"
    ],
    "accessibilityOutcomes": ["announces-message", "does-not-trap-focus"],
    "motion": {
      "kind": "toast-enter-exit",
      "durationToken": "motion-standard",
      "easing": "ease-out",
      "direction": "block-start",
      "reducedMotion": "none"
    },
    "platformAdaptations": {
      "react": ["Portal placement follows the viewport and DOM stacking context."],
      "swiftUI": ["Overlay placement follows safe areas and native transition composition."]
    }
  }
}
