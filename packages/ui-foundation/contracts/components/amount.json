{
  "$schema": "../schema/component-intent.schema.json",
  "component": "amount",
  "maturity": "preview",
  "lists": {
    "sizes": ["md", "lg"],
    "fractions": {
      "description": "Where the fraction (\".25\" of \"$13.25\") sits. Both draw it at half size: `raised` lifts it towards the top of the integer digits, as a superscript; `baseline` keeps it on the baseline of the integer digits.",
      "values": ["raised", "baseline"]
    },
    "slots": ["amount", "amount-fraction"],
    "states": ["rest"],
    "visualArchetypes": ["surface"]
  },
  "contract": {
    "defaultSize": "md",
    "sizes": {
      "$ref": "#/lists/sizes"
    },
    "defaultFraction": "raised",
    "fractions": {
      "$ref": "#/lists/fractions"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  },
  "intent": {
    "description": "What an amount is, independent of any platform: its display size and where its fraction sits. On iOS the size is the display role (AtomDisplayRole).",
    "axes": {
      "size": ["md", "lg"],
      "fraction": ["raised", "baseline"]
    },
    "platforms": {
      "web": {
        "props": {
          "size": {
            "list": "sizes",
            "map": {
              "md": {
                "size": "md"
              },
              "lg": {
                "size": "lg"
              }
            },
            "extensions": {}
          },
          "fraction": {
            "list": "fractions",
            "map": {
              "raised": {
                "fraction": "raised"
              },
              "baseline": {
                "fraction": "baseline"
              }
            },
            "extensions": {}
          }
        }
      },
      "ios": {
        "props": {
          "role": {
            "swiftEnum": "AtomDisplayRole",
            "map": {
              "display": {
                "size": "md"
              },
              "displayLarge": {
                "size": "lg"
              }
            },
            "extensions": {}
          },
          "fraction": {
            "swiftEnum": "AtomAmountFraction",
            "map": {
              "raised": {
                "fraction": "raised"
              },
              "baseline": {
                "fraction": "baseline"
              }
            },
            "extensions": {}
          }
        }
      }
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "amount",
    "reactRenderer": "Amount",
    "swiftUIRenderer": "AtomAmountText",
    "intent": "Show a money amount in a display text role, formatted for the locale, with its fraction at half size, raised or on the baseline.",
    "parity": "strict",
    "requiredStates": ["rest"],
    "sharedOutcomes": ["amount-is-formatted-for-the-locale", "fraction-is-drawn-at-half-size"],
    "accessibilityOutcomes": ["amount-reads-as-one-label"],
    "platformAdaptations": {
      "react": ["Formats with Intl.NumberFormat and draws tabular figures."],
      "swiftUI": [
        "Formats with FormatStyle.Currency, draws monospaced digits and scales with Dynamic Type."
      ]
    }
  }
}
