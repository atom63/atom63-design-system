{
  "$schema": "../schema/component-intent.schema.json",
  "component": "field",
  "maturity": "stable",
  "lists": {
    "orientations": ["vertical", "horizontal", "responsive"],
    "legendVariants": ["legend", "label"],
    "states": ["default", "invalid", "disabled"],
    "slots": [
      "field-set",
      "field-legend",
      "field-group",
      "field",
      "field-content",
      "field-label",
      "field-title",
      "field-description",
      "field-separator",
      "field-separator-content",
      "field-error"
    ],
    "visualArchetypes": ["field", "choice"]
  },
  "contract": {
    "defaultLegendVariant": "legend",
    "defaultOrientation": "vertical",
    "legendVariants": {
      "$ref": "#/lists/legendVariants"
    },
    "orientations": {
      "$ref": "#/lists/orientations"
    },
    "slots": {
      "$ref": "#/lists/slots"
    },
    "states": {
      "$ref": "#/lists/states"
    },
    "visualArchetypes": {
      "$ref": "#/lists/visualArchetypes"
    }
  },
  "intent": {
    "description": "What a form field is, independent of any platform: how its label and control are laid out, how a fieldset legend is drawn, and its chrome. iOS has no orientation or legend axis (native Form layout reflows for Dynamic Type); the web Field has no variant, which only AtomFormField takes so far.",
    "axes": {
      "orientation": ["vertical", "horizontal", "responsive"],
      "legend": ["legend", "label"],
      "variant": ["default", "filled"]
    },
    "platforms": {
      "web": {
        "props": {
          "orientation": {
            "list": "orientations",
            "map": {
              "vertical": {
                "orientation": "vertical"
              },
              "horizontal": {
                "orientation": "horizontal"
              },
              "responsive": {
                "orientation": "responsive"
              }
            },
            "extensions": {}
          },
          "legendVariant": {
            "list": "legendVariants",
            "map": {
              "legend": {
                "legend": "legend"
              },
              "label": {
                "legend": "label"
              }
            },
            "extensions": {}
          }
        }
      },
      "ios": {
        "props": {
          "variant": {
            "swiftEnum": "AtomFieldVariant",
            "map": {
              "default": {
                "variant": "default"
              },
              "filled": {
                "variant": "filled"
              }
            },
            "extensions": {}
          }
        }
      }
    }
  },
  "crossRenderer": {
    "foundationAxis": "states",
    "catalogItem": "formField",
    "reactRenderer": "Field",
    "swiftUIRenderer": "AtomFormField",
    "intent": "Associate a control with its label, supporting description, and validation feedback.",
    "parity": "strict",
    "requiredStates": ["default", "invalid", "disabled"],
    "sharedOutcomes": [
      "label-identifies-control",
      "description-explains-input",
      "invalid-state-exposes-error"
    ],
    "accessibilityOutcomes": ["associates-label", "associates-description", "announces-error"],
    "platformAdaptations": {
      "react": ["Uses DOM label and description relationships."],
      "swiftUI": ["Uses native Form layout and may reflow vertically for Dynamic Type."]
    }
  }
}
